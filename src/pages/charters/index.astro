---
import MainLayout from '../../layouts/MainLayout.astro';
import InteractiveSearch from '../../components/InteractiveSearch.jsx';
import { getAllVessels } from '../../lib/dataService';

const vessels = await getAllVessels();
---

<MainLayout title="Search & Filter Private Boat Charters | MarineCharter">
  <main class="max-w-7xl mx-auto px-4 py-10">
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-slate-900">Private Boat Charter Directory</h1>
      <p class="text-xs text-slate-500 mt-1">Filter by vessel layout, group capacity, menu inclusions, and route details.</p>
    </div>

    <InteractiveSearch client:load initialVessels={vessels || []} />
  </main>
</MainLayout>