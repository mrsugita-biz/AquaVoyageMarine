---
import MainLayout from '../../layouts/MainLayout.astro';
import GroupCalculator from '../../components/GroupCalculator.jsx';
import { getVesselBySlug, getAllVessels } from '../../lib/dataService';

// Generates static routes for all mock vessels at build time
export async function getStaticPaths() {
  const vessels = await getAllVessels();
  return vessels.map((vessel) => ({
    params: { slug: vessel.slug },
  }));
}

const { slug } = Astro.params;
const vessel = await getVesselBySlug(slug || '');

if (!vessel) {
  return Astro.redirect('/404');
}
---

<MainLayout title={`${vessel.title} | MarineCharter`}>
  <main class="max-w-7xl mx-auto px-4 py-8">
    <!-- Header Breadcrumb & Title -->
    <div class="mb-6">
      <div class="flex items-center space-x-2 text-xs text-slate-500 mb-2">
        <a href="/" class="hover:underline">Home</a>
        <span>/</span>
        <a href="/charters" class="hover:underline">Charters</a>
        <span>/</span>
        <span class="text-slate-800 font-semibold">{vessel.title}</span>
      </div>
      <span class="text-xs font-bold uppercase text-blue-600 bg-blue-50 px-3 py-1 rounded-full">
        {vessel.vessel_type}
      </span>
      <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mt-2">{vessel.title}</h1>
      <p class="text-xs text-slate-500 mt-1">📍 Departs from {vessel.departure_port} • Max {vessel.max_capacity} Guests</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left Column: Vessel Details & Specs -->
      <div class="lg:col-span-2 space-y-8">
        <!-- Main Image -->
        <div class="aspect-video bg-slate-100 rounded-2xl overflow-hidden border border-slate-200 shadow-sm">
          <img 
            src={vessel.image_urls[0] || "/images/placeholder-boat.jpg"} 
            alt={vessel.title} 
            class="w-full h-full object-cover" 
          />
        </div>

        <!-- Quick Specs Banner -->
        <div class="grid grid-cols-3 gap-4 bg-slate-100 p-4 rounded-xl text-center text-xs border border-slate-200">
          <div>
            <span class="block text-slate-400 font-semibold uppercase">Length</span>
            <span class="text-sm font-bold text-slate-800">{vessel.length_ft} ft</span>
          </div>
          <div>
            <span class="block text-slate-400 font-semibold uppercase">Duration</span>
            <span class="text-sm font-bold text-slate-800">{vessel.duration_hours} Hours</span>
          </div>
          <div>
            <span class="block text-slate-400 font-semibold uppercase">Catering</span>
            <span class="text-sm font-bold text-slate-800">{vessel.has_vegetarian_menu ? "Veg Options" : "Standard"}</span>
          </div>
        </div>

        <!-- Description -->
        <div>
          <h2 class="text-lg font-bold text-slate-900 mb-2">Overview</h2>
          <p class="text-xs text-slate-600 leading-relaxed">{vessel.description}</p>
        </div>

        <!-- Inclusions -->
        {vessel.inclusions && vessel.inclusions.length > 0 && (
          <div>
            <h2 class="text-lg font-bold text-slate-900 mb-3">What's Included</h2>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              {vessel.inclusions.map((inclusion) => (
                <li class="text-xs text-slate-700 flex items-center space-x-2 bg-white p-2.5 rounded-lg border border-slate-200">
                  <span class="text-emerald-500 font-bold">✓</span>
                  <span>{inclusion}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Sample Itinerary Timeline -->
        {vessel.itinerary_timeline && vessel.itinerary_timeline.length > 0 && (
          <div>
            <h2 class="text-lg font-bold text-slate-900 mb-4">Sample Itinerary</h2>
            <div class="border-l-2 border-blue-500 pl-4 space-y-4">
              {vessel.itinerary_timeline.map((item) => (
                <div class="text-xs">
                  <span class="font-bold text-blue-600">{item.time}</span>
                  <p class="text-slate-700 mt-0.5">{item.activity}</p>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Right Column: Interactive Estimator Widget -->
      <div class="lg:col-span-1">
        <div class="sticky top-24">
          <GroupCalculator 
            client:load
            basePriceUsd={vessel.base_price_usd}
            maxCapacity={vessel.max_capacity}
            affiliateUrl={vessel.affiliate_url}
            addons={vessel.addons || []}
          />
        </div>
      </div>
    </div>
  </main>
</MainLayout>