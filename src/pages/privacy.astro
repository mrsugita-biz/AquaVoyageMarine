---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Privacy Policy & Affiliate Disclosure | MarineCharter">
  <main class="max-w-4xl mx-auto px-4 py-12 space-y-8">
    <h1 class="text-3xl font-extrabold text-slate-900">Privacy Policy & Affiliate Disclosure</h1>

    <div class="prose prose-slate text-xs leading-relaxed space-y-6 text-slate-600">
      <section id="affiliate" class="bg-blue-50/60 p-6 rounded-2xl border border-blue-100">
        <h2 class="text-sm font-bold text-blue-950 mb-2">FTC & Affiliate Partner Disclosure</h2>
        <p class="text-blue-900">
          MarineCharter participates in travel affiliate marketing programs, including Viator and GetYourGuide. This means we may earn a referral commission when you click on links to partner sites and complete a booking—at no extra cost to you. Rates shown are guaranteed official partner prices.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-base font-bold text-slate-900">Data Collection & Cookies</h2>
        <p>
          We use anonymized cookies and analytical services (such as Google Analytics) to improve user experience, monitor site performance, and ensure correct affiliate attribution. We do not store financial or payment transaction details on our servers.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-base font-bold text-slate-900">Third-Party External Links</h2>
        <p>
          Our site contains outbound links to official booking partners. Once redirected, your transaction is governed by the privacy policy and terms of service of the respective booking vendor.
        </p>
      </section>
    </div>
  </main>
</MainLayout>