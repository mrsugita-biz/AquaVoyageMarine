---
interface Props {
  vessel: {
    slug: string;
    title: string;
    vessel_type: string;
    departure_port: string;
    max_capacity: number;
    duration_hours: number;
    base_price_usd: number;
    image_urls: string[];
    has_vegetarian_menu: boolean;
  }
}

const { vessel } = Astro.props;
---

<div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-md transition flex flex-col h-full">
  <div class="relative aspect-video bg-slate-100 overflow-hidden">
    <img 
      src={vessel.image_urls[0] || "/images/placeholder-boat.jpg"} 
      alt={vessel.title} 
      class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
      loading="lazy"
    />
    <span class="absolute top-3 left-3 bg-slate-900/80 text-white backdrop-blur-md text-xs font-bold px-2.5 py-1 rounded-md">
      {vessel.vessel_type}
    </span>
  </div>

  <div class="p-5 flex flex-col flex-grow justify-between">
    <div>
      <h3 class="font-bold text-slate-900 text-lg line-clamp-1 mb-1">{vessel.title}</h3>
      <p class="text-xs text-slate-500 font-medium mb-4">📍 {vessel.departure_port}</p>

      <div class="flex items-center space-x-3 text-xs font-semibold text-slate-600 bg-slate-50 p-2.5 rounded-lg mb-4">
        <span>👥 Max {vessel.max_capacity} Guests</span>
        <span>•</span>
        <span>⏱️ {vessel.duration_hours} Hours</span>
        {vessel.has_vegetarian_menu && (
          <>
            <span>•</span>
            <span class="text-green-600 font-bold">🥗 Veg Menu</span>
          </>
        )}
      </div>
    </div>

    <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
      <div>
        <span class="block text-xs text-slate-400 font-medium">Starting from</span>
        <span class="text-xl font-extrabold text-blue-600">${vessel.base_price_usd}</span>
      </div>
      <a 
        href={`/charters/${vessel.slug}`}
        class="bg-slate-900 hover:bg-blue-600 text-white text-xs font-bold px-4 py-2.5 rounded-lg transition"
      >
        View Details
      </a>
    </div>
  </div>
</div>